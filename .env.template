# ── makeaibilli v2 config ──────────────────────────────
# Copy to .env and add your Finnhub key (free at finnhub.io)
FINNHUB_API_KEY=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
DB_PATH=/data/makeaibilli.db

# Light scan (fast sources + re-rank the 90): every N minutes
SCAN_INTERVAL_MINUTES=30
# Heavy sweep (Fortune 500 + IPO + deep reprocess): every N minutes
HEAVY_SWEEP_MINUTES=60
# Recalculate the ranked lists (decisions) this often — total cycle
DECISION_INTERVAL_MINUTES=90
# Keep scrapes/decisions this many days, then auto-delete
RETENTION_DAYS=15
